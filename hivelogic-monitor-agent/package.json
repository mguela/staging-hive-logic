{
 "name": "hivelogic-monitor",
 "productName": "HiveLogic Monitor",
 "version": "1.3.3",
 "description": "HiveLogic's WebWork replacement -- desktop activity + screenshot tracker. Only captures while the employee is clocked in on HiveLogic.",
 "main": "src/main.js",
 "author": "Greenwich Handyman / HiveLogic",
 "license": "UNLICENSED",
 "private": true,
 "scripts": {
  "start": "electron .",
  "build:win": "electron-builder --win --x64",
  "build:mac": "electron-builder --mac --universal",
  "build:all": "electron-builder --win --x64 --mac --universal"
 },
 "dependencies": {
  "get-windows": "^9.3.0",
  "electron-updater": "^6.3.9"
 },
 "devDependencies": {
  "electron": "^31.0.0",
  "electron-builder": "^24.13.3"
 },
 "build": {
  "appId": "com.hivelogic.monitor",
  "productName": "HiveLogic Monitor",
  "directories": {
   "output": "dist"
  },
  "files": [
   "src/**/*",
   "package.json",
   "node_modules/**/*"
  ],
  "win": {
   "target": [
    "nsis"
   ],
   "icon": "build/icon.ico"
  },
  "mac": {
   "target": [
    "dmg"
   ],
   "icon": "build/icon.icns",
   "category": "public.app-category.business",
   "hardenedRuntime": true,
   "gatekeeperAssess": false
  },
  "nsis": {
   "oneClick": true,
   "perMachine": false
  },
  "publish": [
   {
    "provider": "github",
    "owner": "csk5369",
    "repo": "hivelogic-monitor"
   }
  ],
  "artifactName": "HiveLogic-Monitor-Setup-v${version}.${ext}"
 },
 "allowScripts": {
  "electron@31.7.7": true,
  "get-windows@9.3.0": true
 }
}
