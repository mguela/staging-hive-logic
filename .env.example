# HiveLogic - environment variables
# Copy this file to .env.local, fill in real values, never commit the filled-in file.
# Ask Chris (or whoever owns each service) for the actual secrets - do not request these over Slack in plaintext.

# --- Core / runtime ---
NODE_ENV=development
VERCEL_ENV=
HIVELOGIC_TENANT_ID=ghgrp
CRON_SECRET=
# 32 random bytes encoded as base64. See docs/SECURITY_OPERATIONS.md.
TOKEN_ENC_KEY=
# Comma-separated prior 32-byte keys; non-empty only during rotation.
TOKEN_ENC_KEY_PREVIOUS=
# Reader-first rollout default is v1. Set to v2 only after every live and
# rollback deployment contains the dual v1/v2 reader.
TOKEN_ENC_WRITE_VERSION=v1
TEST_WORKFLOW_SECRET=
# Failure-only intake for GitHub's main-branch completion gate.
STATUS_HUB_INGEST_SECRET=

# --- Supabase (main HiveLogic project) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Supabase (HiveConnect project) ---
HIVECONNECT_SUPABASE_URL=
HIVECONNECT_SUPABASE_SERVICE_KEY=

# --- Anthropic / Reina AI ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
REINA_MODEL=
CLASSIFIER_MODEL=
HIVELOGIC_REINA_LEARNING_AUTOFILL_ENABLED=

# --- Reina controlled Voice transcription (short clips, immediately discarded) ---
OPENAI_API_KEY=
REINA_VOICE_TRANSCRIPTION_ENABLED=
REINA_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# --- Reina AI Council (disabled by default; all three provider configs required) ---
REINA_COUNCIL_ENABLED=false
REINA_COUNCIL_OPENAI_MODEL=
REINA_COUNCIL_ANTHROPIC_MODEL=
REINA_COUNCIL_XAI_MODEL=
XAI_API_KEY=
# Current provider pricing must be configured as positive cents per million tokens.
# Do not hardcode pricing in application code; update these when a model changes.
REINA_COUNCIL_OPENAI_INPUT_CENTS_PER_MILLION=
REINA_COUNCIL_OPENAI_OUTPUT_CENTS_PER_MILLION=
REINA_COUNCIL_ANTHROPIC_INPUT_CENTS_PER_MILLION=
REINA_COUNCIL_ANTHROPIC_OUTPUT_CENTS_PER_MILLION=
REINA_COUNCIL_XAI_INPUT_CENTS_PER_MILLION=
REINA_COUNCIL_XAI_OUTPUT_CENTS_PER_MILLION=
REINA_COUNCIL_MAX_ROUNDS=3
REINA_COUNCIL_MAX_TOKENS_PER_RESPONSE=2000
REINA_COUNCIL_MAX_COST_CENTS=500
REINA_COUNCIL_MAX_CONCURRENT_RUNS=1
REINA_COUNCIL_DAILY_COST_CENTS=2000

# --- Jobber ---
JOBBER_CLIENT_ID=
JOBBER_CLIENT_SECRET=
JOBBER_REDIRECT_URI=

# --- QuickBooks Online ---
QBO_ENVIRONMENT=
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=
HIVELOGIC_QBO_WRITE_ENABLED=
HIVELOGIC_QBO_WRITE_URL=
HIVELOGIC_QBO_WRITE_TOKEN=
HIVELOGIC_QBO_HIGH_VALUE_THRESHOLD=
HIVELOGIC_COMPANY_ID=

# --- Twilio / Quo (phone, SMS) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=
VOICE_GREETING_PIN=

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
MARKETING_EMAIL_SEND_ENABLED=

# --- Microsoft 365 (HiveConnect mail) ---
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URI=

# --- Authorize.Net (payments) ---
AUTHNET_API_LOGIN_ID=
AUTHNET_TRANSACTION_KEY=
AUTHNET_SIGNATURE_KEY=
AUTHNET_ENVIRONMENT=

# --- CompanyCam ---
COMPANYCAM_API_TOKEN=

# --- Vendor catalog / material sourcing ---
SERPAPI_KEY=
LOWES_API_KEY=
LOWES_API_BASE_URL=
LOWES_STORE_NO=
LOWES_ZIP=
LOWES_ZIP_STATE=
UNWRANGLE_API_KEY=
FERGUSON_PUNCHOUT_URL=
FERGUSON_PUNCHOUT_SHARED_SECRET=
FERGUSON_BUYER_DUNS=
FERGUSON_SUPPLIER_DUNS=
RINGSEND_FEED_TABLE=

# --- Misc ---
GOOGLE_REVIEW_LINK=
CLIENTPORTAL_BASE_URL=
SUBPORTAL_BASE_URL=

# --- Bookkeeping module feature flags / store backends ---
BOOKKEEPING_ENABLED=
BOOKKEEPING_ALLOW_MEMORY_STORE=
BOOKKEEPING_CATALOG_STORE=
BOOKKEEPING_CATALOG_MIGRATION_CONFIRMED=
BOOKKEEPING_EVIDENCE_STORE=
BOOKKEEPING_EVIDENCE_MIGRATION_CONFIRMED=
BOOKKEEPING_EXPENSE_STORE=
BOOKKEEPING_EXPENSE_MIGRATION_CONFIRMED=
BOOKKEEPING_LEARNING_STORE=
BOOKKEEPING_LEARNING_MIGRATION_CONFIRMED=
BOOKKEEPING_SALES_TAX_STORE=
BOOKKEEPING_SALES_TAX_MIGRATION_CONFIRMED=
BOOKKEEPING_CO_STORE=
BOOKKEEPING_CO_MIGRATION_CONFIRMED=
BOOKKEEPING_EST_STORE=
BOOKKEEPING_EST_MIGRATION_CONFIRMED=
BOOKKEEPING_PO_STORE=
BOOKKEEPING_PO_MIGRATION_CONFIRMED=
